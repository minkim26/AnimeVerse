VITE_API_URL=http://localhost:8000
# Placeholder is fine for local dev and tests — nothing locally depends on it
# resolving to a real domain. Must be set to the real production domain before
# `npm run build` for an actual deploy: Vite's HTML substitution has no
# fallback, so an unset value ships the literal `%VITE_SITE_URL%` string in
# index.html's canonical tag, og:image, og:url, and JSON-LD.
VITE_SITE_URL=https://animeverse.example
