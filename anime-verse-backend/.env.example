# Copy to .env.local (for `npm run dev` outside Docker) or .env.production
# (for `docker compose up`) and fill in real values. Never commit either file.

# Prisma connection string. Inside Docker Compose, host is the "postgres"
# service name; outside Docker, use localhost.
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/animeverse

# Used by the official postgres Docker image to initialize the database.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=animeverse

# express-oauth2-jwt-bearer reads these two exact names from the
# environment automatically. ISSUER_BASE_URL is the Auth0 tenant's full
# URL including https://; AUDIENCE is the API identifier from Auth0's
# Applications > APIs (must match VITE_AUTH0_AUDIENCE on the frontend
# exactly).
ISSUER_BASE_URL=https://your-tenant.us.auth0.com/
AUDIENCE=https://your-api-identifier

# Test-only. When set, lib/auth.ts verifies tokens with this shared HS256
# secret instead of RS256-via-JWKS against a real Auth0 tenant, so tests
# don't need network access to Auth0. MUST NEVER be set in production —
# lib/auth.ts throws at startup if it is and NODE_ENV=production.
AUTH0_TEST_SIGNING_SECRET=

# Shared secret the anime-cache-refresh cron workflow sends as the
# X-Cron-Secret header on POST /admin/anime-cache/refresh. Not a user
# credential — this endpoint is only ever called by GitHub Actions.
ADMIN_CRON_SECRET=change-me

PORT=8000

# Supabase project created for AnimeVerse (Storage only). SUPABASE_KEY must
# be the service_role key; it is only ever used server-side and must never
# be shipped to the frontend.
SUPABASE_URL=
SUPABASE_KEY=

# RabbitMQ connection string. Inside Docker Compose, host is the "rabbitmq"
# service name.
RABBITMQ_URL=amqp://localhost

# Redis connection string, used for rate limiting and response caching.
# Inside Docker Compose, host is the "redis" service name.
REDIS_URL=redis://localhost:6379

# Comma-separated origins allowed to make cross-origin requests to this API
# (CORS). 5173 is npm run dev's default port; 5174 is the port
# playwright.config.ts deliberately runs the e2e frontend on instead, so
# npm run test:e2e works against this same docker compose backend without
# a CORS wall. Production should list just its one real frontend origin.
FRONTEND_URL=http://localhost:5173,http://localhost:5174

# Production only (compose.prod.yml's cloudflared service). Token for a
# remotely-managed Cloudflare Tunnel, from the Zero Trust dashboard's
# Networks > Tunnels > (tunnel) > Configure > "Docker" install command.
# Not used outside compose.prod.yml.
TUNNEL_TOKEN=
