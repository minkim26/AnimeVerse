datasource db {
    provider = "postgresql"
}

generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

// User model — stores registered application users.
// Passwords are stored as bcrypt hashes — never plain text.
model User {
    id                 Int             @id @default(autoincrement())
    auth0Id            String?         @unique
    email              String          @unique
    avatarUrl          String?
    avatarThumbnailUrl String?
    createdAt          DateTime        @default(now())
    preferences        Preference?
    watchlist          WatchlistItem[]
    reviews            Review[]
    swipes             Swipe[]
}

// Preference — one row per user, full-replace semantics for their genre list.
model Preference {
    userId           Int      @id
    user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    genres           String[]
    showAdultContent Boolean  @default(false)
    updatedAt        DateTime @updatedAt
}

// WatchlistItem — an anime a user has saved. Provisioned for API completeness;
// no frontend page consumes this yet.
model WatchlistItem {
    id        Int      @id @default(autoincrement())
    userId    Int
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    animeId   String
    title     String?
    posterUrl String?
    addedAt   DateTime @default(now())

    @@unique([userId, animeId])
}

// Review — a user's rating/comment on an anime. Provisioned for API
// completeness; no frontend page consumes this yet.
model Review {
    id         Int      @id @default(autoincrement())
    userId     Int
    user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    animeId    String
    rating     Int
    reviewText String
    createdAt  DateTime @default(now())

    @@unique([userId, animeId])
}

// Quote — static anime quote content, seeded once. Replaces the old
// animeQuoteService.py hardcoded list.
model Quote {
    id        Int    @id @default(autoincrement())
    quote     String
    character String
    anime     String
}

// Title — static anime title/episode-count content, seeded once. Replaces
// the old animeTitleService.py hardcoded list.
model Title {
    id       Int    @id @default(autoincrement())
    title    String
    episodes Int
}

// Anime is a cache-aside table populated whenever a Swipe references an
// AniList id not yet cached (or stale). tasteVector is a pgvector column:
// Prisma's generated client can't read or write Unsupported types, so
// lib/animeCache.ts reads/writes it via $queryRaw/$executeRaw. Nullable
// only to satisfy Prisma's migration requirement for Unsupported columns;
// it's always set via raw SQL on insert.
model Anime {
    id             Int       @id
    title          String
    posterUrl      String?
    synopsis       String
    tags           Json
    tasteVector    Unsupported("vector(335)")?
    isAdult        Boolean   @default(false)
    lastVerifiedAt DateTime?
    updatedAt      DateTime  @updatedAt

    swipes Swipe[]
}

enum SwipeAction {
    SKIP
    LIKE
    LOVE
}

// Swipe holds one row per (user, anime) swipe decision from the Discover
// deck. Re-swiping the same anime updates the row rather than duplicating it.
model Swipe {
    id        Int         @id @default(autoincrement())
    userId    Int
    user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
    animeId   Int
    anime     Anime       @relation(fields: [animeId], references: [id])
    action    SwipeAction
    createdAt DateTime    @default(now())

    @@unique([userId, animeId])
}
